import pandas as pd
import numpy as np
from sklearn.preprocessing import LabelEncoder

df = pd.read_csv("iris.csv")
df.head()


df.info()

df.isnull().sum()

df['species'].value_counts()

le = LabelEncoder()
df['Species_Label'] = le.fit_transform(df['species'])
df.head()


le.classes_
mapping = dict(zip(le.classes_, le.transform(le.classes_)))
