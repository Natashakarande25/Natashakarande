ii. Outliers
In this, we are using the dataset “wine.csv”

df = pd.read_csv(r"C:\Users\User\Downloads\DS\wine.csv")
import matplotlib.pyplot as plt
import seaborn as sns
df.head()

df.info()

df.isnull().sum()

for col in df.select_dtypes(include = ['float64' , 'int64']).columns:
    plt.figure(figsize=(6,4))
    sns.boxplot(x=df[col])
    plt.title(f"Box of {col}")
    plt.show()

numeric_cols = df.select_dtypes(include = ['float64' , 'int64']).columns
numeric_cols
outlier_bounds = {}

for col in numeric_cols :
    Q1 = df[col].quantile(0.25)
    Q3 = df[col].quantile(0.75)
    IQR = Q3 - Q1
    lower_whisker = Q1 - 1.5 * IQR
    upper_whisker = Q3 + 1.5 * IQR
    outlier_bounds[col]=(lower_whisker, upper_whisker)

outlier_bounds

for col in numeric_cols:
    lw, uw = outlier_bounds[col]
    outliers = df[(df[col] < lw) | (df[col] > uw)][col].count()
    print(f"After capping {col} : {outliers} outliers")



