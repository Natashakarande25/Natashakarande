import pandas as pd

data = {
    'Make': ['Honda', 'Honda', 'Toyota', 'Nissan', 'Toyota', 'Honda', 'Ford', 'Chevrolet', 'Chevrolet', 'Dodge', 'Dodge'],
    'Model': ['Accord', 'Accord', 'Camry', 'Altima', 'Corolla', 'Civic', 'F-150', 'Silverado', 'Impala', 'Charger', 'Charger'],
    'Color': ['Red', 'Blue', 'Green', 'Black', 'Green', 'White', 'Black', 'Green', 'Silver', 'Silver', 'Silver'],
    'Mileage': [63512, 95135, 75000, 69847, 87278, 138789, 89073, 109231, 87675, 34853, 58173],
    'Sell Price': [4000, 2500, 45000, 3820, 2224, 2723, 3950, 4050, 3791, 3500, 4252],
